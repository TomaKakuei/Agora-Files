// Agent profile workflow template.
// Agent Profile 工作流模板：flex_api_url 指向任意一个 Flex server。
{
  "workflow_name": "agent_profile_workflow",
  "flex_api_url": "http://127.0.0.1:8000/v1",
  "model": "",
  "default_generation_mode": "auto",
  "default_core_values": [
    "clarity",
    "adaptability"
  ],
  "default_attributes": {
    "baseline_reliability": 60
  },
  "default_runtime_tags": [
    "generic-agent"
  ],
  "default_voice_style": "clear and grounded",
  "default_stance": "balanced",
  "output_subdir": "output/agent_profile_workflow",
  "generated_profile_filename": "generated_profiles.jsonc",
  "compiled_profile_filename": "compiled_profiles.json",
  "max_retries": 2,
}
