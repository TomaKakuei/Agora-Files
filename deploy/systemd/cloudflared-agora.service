[Unit]
Description=Cloudflare Tunnel for Agora Macro UI
After=network-online.target agora-macro-ui.service
Wants=network-online.target agora-macro-ui.service

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'install -m 0755 /home/yz_wang/yz_main/agora_2.0/deploy/cloudflared/bin/cloudflared /tmp/cloudflared'
ExecStart=/tmp/cloudflared --no-autoupdate tunnel run --token-file /home/yz_wang/.cloudflared/agora_macro_ui.token
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
